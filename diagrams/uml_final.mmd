classDiagram
    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
    }

    class Recurrence {
        <<enumeration>>
        NONE
        DAILY
        WEEKLY
    }

    class Owner {
        +str name
        +int available_minutes_per_day
        +time day_start
        +time day_end
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet_id) void
        +find_pet(pet_id) Pet
        +set_availability(minutes) void
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name, completed) list~Task~
    }

    class Pet {
        +str id
        +str name
        +str species
        +str breed
        +int age
        +str special_needs
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task_id) void
        +complete_task(task_id, on_date) Task
        +edit_task(task_id, changes) void
        +get_tasks(completed) list~Task~
        +describe() str
    }

    class Task {
        +str id
        +str pet_id
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +time preferred_time
        +Recurrence recurrence
        +date due_date
        +date last_completed
        -Pet _pet
        +mark_complete(on_date) Task
        +is_due(on_date) bool
        +next_occurrence() Task
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +dict constraints
        +generate_plan(on_date) DailyPlan
        +sort_tasks(tasks) list~Task~
        +sort_by_time(tasks) list~Task~
        +conflict_warnings(tasks) list~str~
        +detect_conflicts(items) list~tuple~
    }

    class ScheduledItem {
        +Task task
        +time start
        +time end
        +str reason
    }

    class SkippedTask {
        +Task task
        +str reason
    }

    class DailyPlan {
        +date date
        +list~ScheduledItem~ scheduled_items
        +list~SkippedTask~ skipped_tasks
        +list~str~ warnings
        +add_item(task, start, reason) void
        +total_duration() int
        +get_explanation() str
        +to_rows() list
    }

    Owner "1" *-- "*" Pet : has (filter_tasks uses Pet.get_tasks)
    Pet "1" *-- "*" Task : has (add_task sets pet_id and _pet)
    Pet ..> Task : complete_task calls mark_complete
    Task --> Pet : _pet.add_task queues the next occurrence
    Task ..> Task : next_occurrence makes a copy
    Task --> Priority : uses
    Task --> Recurrence : uses
    Scheduler --> Owner : reads get_all_tasks, find_pet, budget, day window
    Scheduler ..> Task : sorts, places, checks for conflicts
    Scheduler ..> DailyPlan : generate_plan builds
    Scheduler ..> SkippedTask : records what did not fit
    Scheduler ..> ScheduledItem : conflict_warnings and detect_conflicts compare
    DailyPlan "1" *-- "*" ScheduledItem : contains (add_item creates)
    DailyPlan "1" *-- "*" SkippedTask : contains
    ScheduledItem --> Task : refers to
    SkippedTask --> Task : refers to
